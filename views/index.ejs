  }

  .icon-right {
    font-size: 0.85rem;
  }

  .ricondizionamento{
    font-size: 2.2rem;
    font-weight: 900;
  }

  .contenitore-ricondizionamento > div img{
    max-width: 400px;
    height: 400px;
  }

  .dove-siamo{
    flex-direction: column;
    margin: 0;
  }

  .posizione{
    margin-left: 50px;
  }

  iframe{
    max-width: 400px;
    margin-top: 30px;
  }

  .div_cat_main{
    width: 95%;
    flex-wrap: wrap;
  }

  .div_cat_main > div{
    width: 100%;
    height: 450px;
    padding: 60px 20px;
  }

  .div_cat_main h3{
    font-size: 1.5rem;
  }

  .div_cat_main p{
    font-size: 0.7rem;
    padding-bottom: 30px;
  }
  .div_cat_main a{
    font-size: 0.6rem;
    padding: 10px 20px;
  }

  .catalog_img, .form_img{
    height: 100px;
    margin-top: 100px;
  }
}

/* TELEFONI PICCOLI */
@media (max-width: 375px){
  .main_text p{
    font-size: 0.7rem;
  }
  .row{
    padding-left: 30px;
  }
}

</style>

