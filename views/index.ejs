/* MAIN TEXT */
.main_text{
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  top: -500px;
  width: 100%;
  z-index: 900;
}

h1{
  font-size: 64px;
  line-height: 1.3;
  color: white;
  font-weight: 900;
  margin: 30px 0;
  /* text-shadow: 0.5px 0.5px 0 currentColor; */
}

.main_text p{
  color: #F28123;
  font-weight: 900;
  text-transform: uppercase;
  letter-spacing: 7px;
  font-size: 15px;
}

.main_text_btn{
  flex-grow: 2;
}

.main_text_btn button{
  border-color: #0014b9;
  border-radius: 50px;
  padding: 10px 20px;
  cursor: pointer;
  transition: 0.3s;
  font-size: 1rem;
  text-decoration: none;
  transition: 0.3s;
  font-weight: 900;
}

.btn_one{
  background-color: #0014b9;
  color: white;
}

.btn_one:hover{
  color: #0014b9;
  background-color: #F28123;
}

.btn_two{ 
  color: #F28123;
  background-color: transparent;
  margin-left: 15px;
} 
.btn_two:hover{
  background-color: #0014b9;
}



/* FEATURES LIST SECTION */
.row{
  background-color: #f5f5f5;
  display: flex;
  justify-content: center;
}

.list-box{
  display: flex;
  align-items: center;
  margin: 75px 140px 75px 0;
}

.fas{
  color: #0014b9;
  font-size: 24px;
  margin-right: 15px;
  width: 65px;
  height: 65px;
  text-align: center;
  line-height: 60px;
  border: 2px #0014b9 dotted;
  border-radius: 999px;
}

.content h3{
  line-height: 22px;
  font-size: 18px;
  margin-bottom: 4px;
  font-weight: 800;
  letter-spacing: 0.5px;
}

.content p{
  opacity: 0.75;
  font-weight: 400;
  font-size: 1rem;
  letter-spacing: 0.1px;
  line-height: 1.8;
}

/* SHOP */
.card-container {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 120px;
  padding: 10px;
  max-width: 90%;
  margin: 0 auto;
  margin-top: 50px;
}

.card {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  flex-wrap: wrap;
  text-align: center;
  background-color: white;
  border-radius: 5px;
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
  overflow: hidden;
  padding: 20px;
  transition: box-shadow 0.1s ease-in-out;
  align-items: center;
}

.card:hover {
  box-shadow: none;
  cursor: pointer;
}

.card-content {
  width: 100%;
  margin-top: auto;
}
.card:hover {
  transform: translateY(-5px);
}

.card img {
  max-width: 100%;
  height: auto;
  display: block;
}

.card h3 {
  font-size: 1.2rem;
  margin: 15px 0 5px 0;
  color: #0014b9;
}

.card a, .box_descrizzione p {
  font-size: 1rem;
  color: #3073c0;
}
.icon-right {
  margin-left: 8px;
  color: #3073c0;
  font-size: 0.95rem;
  vertical-align: middle;
  transition: transform 0.2s ease;
}

a:hover .icon-right {
  transform: translateX(4px);
}
/* ANIMAZIONE */
@keyframes fadeInUp {
  0% {
    opacity: 0;
    transform: translateY(30px);
  }
  100% {
    opacity: 1;
    transform: translateY(0);
  }
}

.card {
  opacity: 0;
  animation: fadeInUp 0.6s ease-out forwards;
}

/* Ritardo progressivo per effetto "a cascata" */
.card:nth-child(1) { animation-delay: 0.1s; }
.card:nth-child(2) { animation-delay: 0.2s; }
.card:nth-child(3) { animation-delay: 0.3s; }
.card:nth-child(4) { animation-delay: 0.4s; }
.card:nth-child(5) { animation-delay: 0.5s; }


/* BOX DESCRIZZIONE */
.box_descrizzione{
  max-width: 80%;
  margin: 0 auto;
  padding-top: 150px;
  display: flex;
}

.box_descrizzione_div_uno{
  padding-right: 50px;
}

.box_descrizzione h2{
  font-size: 3rem;
  color: #0014b9;
  margin-top: 100px;
}

.box_descrizzione p{
  font-size: 1.2rem;
  margin-top: 30px;
  line-height: 30px;
}

.box_descrizzione img{
  width: 500px;
  margin-top: 100px;
  border-radius: 5%;
  transition: opacity 1s ease, transform 1s ease;
}
@keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
}

/* RICONDIZIONAMENTO */
.ricondizionamento{
  font-size: 3rem;
  color: #0014b9;
  text-align: center;
  margin-top: 100px;
}

section > h2{
  font-size: 3rem;
  color: #0014b9;
  text-align: center;
  padding-top: 140px;
}

.contenitore-ricondizionamento{
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 30px;
  margin: 100px 0;
}

.contenitore-ricondizionamento > div{
  position: relative;
}

.descrizzione-ricondizionamento{
  position: absolute;
  width: 80%;
  text-align: center;
  color: white;
  font-size: 2rem;
  font-weight: 900;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  background-color: #3073c07c;
  padding: 10px 20px;
  border-radius: 8px;
}

.contenitore-ricondizionamento img{
  width: 500px;
  height: 500px;
  border-radius: 20%;
}

.link-ricondizionamento{
  position: absolute;
  color: white;
  bottom: 20px;
  left: 50%;
  transform: translate(-50%);
  background-color: rgba(103, 207, 255, 0.5);
  padding: 10px 20px;
  border-radius: 8px;
}

.contenitore-ricondizionamento i{
  color: white;
}

/* DOVE SIAMO */
.dove-siamo{
  margin: 20px 10% 0 10%;
  padding-bottom: 100px;
  display: flex;
}

.dove_siamo_h2{
  margin-bottom: 10px;
  font-size: 3rem;
  color: #0014b9;
  padding: 50px;
}
.dove-siamo p, a{
  margin-bottom: 5px;
  font-size: 1.3rem;
  color: #3073c0;
}

.posizione{
  display: inline-block;
  vertical-align: top;
  margin-right: 20%;
}
.posizione img{
  margin: 10px 15px 0 0;
}
iframe, .posizione{
  margin-top: 10px;
}

/* CATALOGO */
.div_cat_main {
  width: 80%;
  margin: 0 auto;
  display: flex;
  gap: 20px;
  justify-content: space-between;
  padding-bottom: 100px;
}

.div_cat_main > div{
  width: 50%;
  padding: 70px;
  border-radius: 20%;
}

.div_cat_main h3{
  font-size: 2.5rem;
  font-weight: 900;
  color: #0014b9;
}

.div_cat_main p{
  color: #0014b9;
  font-weight: 600;
  padding: 20px 0 50px 0;
}

.div_cat_main a{
  border: 2px solid #0014b9;
  border-radius: 50px;
  padding: 15px 25px;
  cursor: pointer;
  transition: 0.3s;
  font-size: 1rem;
  text-decoration: none;
  transition: 0.3s;
  margin-top: 50px;
  font-weight: 900;
  color: white;
  background-color: #0014b9;
}

.div_cat_primo{
  background-color: white;
}
.div_cat_primo a:hover{
  color: #0014b9;
  background-color: #F28123;
}

.div_cat_sec{
  background: linear-gradient(#0014b9, #3346d1);
}
.div_cat_sec h3{
  color: white;
}
.div_cat_sec p{
  color: rgb(223, 223, 223);
}
.div_cat_sec a{
  color: #F28123;
  border: 2px solid rgb(223, 223, 223);
  background-color: transparent;
}
.div_cat_sec a:hover{
  background-color: white;
}

.catalog_img, .form_img{
  background-image: url(imgs/catalogo.png);
  height: 200px;
  background-size: 100% 100%;
  background-size: contain;
  background-position:left;
  background-repeat: no-repeat;
  margin: 100px 0;
}

.form_img{
  background-image: url(imgs/form.png);
}

/* RESPONSIVNESS */
/* TELEFONO */
@media (max-width: 640px) {
  .banner{
