<%- include('partials/header', { metaDescription: 'Everest Casale Monferrato: vendita e assistenza di frigoriferi professionali per vino, bevande, gelati, market e catering. Ricondizionati e pronti all uso.', pageTitle: 'Everest - Attrezzature Frigoriferi Professionali' }) %>
<style>
    .banner{
        height: 50vh;
    }
    .main_text{
        display: flex;
        flex-direction: column;
        align-items: center;
        position: relative;
        top: -250px;
        width: 100%;
        z-index: 900;
    }

    h1{
        font-size: 64px;
        line-height: 1.3;
        color: white;
        font-weight: 900;
        margin: 30px 0;
        /* text-shadow: 0.5px 0.5px 0 currentColor; */
    }

    .main_text p{
        color: #F28123;
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: 7px;
        font-size: 15px;
    }

    form{
        display: flex;
        justify-content: center;
        margin: -100px 0 100px 0;
    }

    .frm-father-div{
        display: grid;
        grid-template-columns: 1fr 1fr;
        grid-template-rows: auto auto;
        width: 60%;
        padding: 50px;
        gap: 30px;
    }
    .lng-frm-div{
        grid-column: 1 / 3;
    }

    label{
        font-size: 18px;
        font-weight: 700;
        color: #3073c0;
        margin-top: 20px;
        display: block;
    }

    select{
        border: 2px solid #ccc;
        border-radius: 4px;
        -webkit-appearance: none;
        -moz-appearance: none;
        appearance: none;

        background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='12' height='8' viewBox='0 0 12 8'><path fill='%230014b9' d='M1 1l5 6 5-6'/></svg>");
        background-repeat: no-repeat;
        background-position: right 12px center;
        background-size: 12px;
    }
    textarea{
        font-size: 18px !important;
    }
    input, select, textarea{
        font-size: inherit;
        padding: 15px;
        border-radius: 3px;
        transition: border-color 0.5s ease;
        background-color: #E1ECF5;
        color: #3073c0;
        border: none;
    }
    input:focus, select:focus, textarea:focus {
        border-color: #3073c0;
        outline: none;
    }
    label, input, select, textarea{
        width: 100%;
    }
    input, select, textarea{
        margin-top: 10px;
    }

    button{
        border-color: #0014b9;
        background-color: #0014b9;
        border-radius: 3px;
        padding: 10px 20px;
        transition: 0.3s;
        color: white;
        cursor: pointer;
        margin-top: 20px;
        font-size: 18px;
    }

    .info-box{
        display: flex;
        flex-direction: column;
        padding: 30px;
        background-color: #FBFBFB;
        border-radius: 5px;
        height: 400px;
        margin-top: 100px;
    }

    .description{
        margin-bottom: 40px;
    }

    .info-box > div{
        display: flex;
    }

    .icon{
        color: #0014b9;
        margin-right: 10px;
        line-height: 1.5;
        font-size: 20px;
    }

    h4{
        font-size: 22px;
        font-weight: 900;
        margin-bottom: 10px;
    }
    
    .description > p{
        opacity: 0.8;
    }

    .location{
        display: flex;
        justify-content: center;
        background-color: #3073c0;
        padding: 100px 0;
    }

    .location i{
        font-size: 40px;
        color: #0014b9;
        margin-right: 20px;
        line-height: 1.2;
    }
    .find-our-location{
        font-size: 40px;
        font-weight: 900;
        color: white;
    }
    iframe{
        display: block;
    }

    @media (min-width: 300px) and (max-width: 640px) {
        h1{
            font-size: 30px;
        }
        .main_text p{
            font-size: 1rem;
        }
        form{
            flex-wrap: wrap;
        }

        .frm-father-div{
            width: 100%;
            padding: 50px 10px;
        }

        .shrt-frm-div, button{
            grid-column: 1 / 3;
        }

        .info-box{
            margin: 20px 10px;
        }

        .location i, .find-our-location{
            font-size: 20px;
        }

        .location i{
            margin-right: 10px;
        }

        iframe{
            height: 200px;
        }
    }
</style>

