<%- include('partials/header', { metaDescription: 'Vendita di frigoriferi professionali per wine, beverage, gelato, market e catering. Prodotti nuovi e ricondizionati, garantiti e assistiti da esperti del settore.', pageTitle: 'Vendita - Everest Casale Monferrato' }) %>

<style>

.banner {
  position: relative;
  z-index: 50;
}

.viola{
    color: #733151;
}

.blu-chiaro{
    color: #2ec3e7;
}

.blu-scuro{
    color: #2484c6;
}

.giallo{
    color: #faa61a;
}

.verde{
    color: #00663a;
}

h1{
    font-size: 3rem;
    margin-top: 50px;
    margin-left: 10%;
    color: #0014b9;
}

/* MENU PRODOTTI */
.wrapper {
  display: flex;
  flex-direction: row;
  width: 80%;
  margin: 0 auto;
  padding: 60px 0;
}

.contenitore-indice {
  position: sticky;
  top: 150px; 
  width: 15%;
  display: flex;
  flex-direction: column;
  align-self: flex-start;
  z-index: 20;
}

.contenitore-indice > div{
    margin: 5px 0;
}
.contenitore-indice h2{
    color: white;
    font-size: 2.5rem;
    text-align: center;
    padding: 10px 0;
}

h2 a,
h2 a:visited,
h2 a:hover,
h2 a:active {
  color: inherit;
}

/* CONTENITORE PRODOTTI */

.contenitore-prodotti {
  margin-left: 10%;
  display: flex;
  flex-wrap: wrap;
  width: 80%;
  gap: 10px;
}
.contenitore-prodotti h2{
    display: inline;
    width: 100%;
    font-size: 2.5rem;
}

hr{
    width: 100px;
    height: 10px;
    border: 0;
}
.contenitore-prodotti > div {
  width: 500px;
  height: 600px;
  display: flex;
  flex-direction: column;
  align-items: center;
  border: 1px solid rgb(202, 202, 202);
}


.img-prodotto{
    margin: 0 auto;
    width: 100%;
    height: 70%;
    overflow: hidden;
}

.contenitore-prodotti .img-prodotto > img{
    width: 100%;
    height: 100%;
    object-fit: contain;
}

.contenitore-prodotti h3{
    text-align: center;
    font-weight: 900;
    padding: 20px 0;
}

.prod-info {
    display: flex;
    list-style: none;
    margin: 0 auto; 
}

.prod-info li {
  display: flex;
  align-items: center;
  margin-right: 10px;
  font-size: 0.9rem;
}

.prod-info li i {
  margin-right: 6px;
}

.contenitore-prodotti p{
    color: #1B1F23;
    padding-top: 20px;
}

.icon-right {
  margin-left: 8px;
  color: #1B1F23;
  font-size: 0.95rem;
  vertical-align: middle;
  transition: transform 0.2s ease;
}

.contenitore-prodotti p:hover .icon-right {
  transform: translateX(4px);
}
/* ANIMAZIONE */
@keyframes fadeInUp {
  0% {
    opacity: 0;
    transform: translateY(30px);
  }
  100% {
    opacity: 1;
    transform: translateY(0);
  }
}

/* RESPONSIVNESS */

/* TABLET e più piccoli */
@media (max-width: 1024px) {
    .contenitore-indice{
        display: none;
    }
    h1{
        display: none;
    }
}

/* TELEFONO */
@media (max-width: 640px) {
    .wrapper{
        width: 100%;
        padding: 30px 0;
    }
    .contenitore-prodotti h2{
        font-size: 1.5rem;
    }
    .contenitore-prodotti h3{
        font-size: 1rem;
    }

    .contenitore-prodotti hr{
        height: 5px;
    }
    .contenitore-prodotti > div{
        height: 350px;
        padding: 10px;
    }

    .prod-info li{
        margin: 0;
    }

    .mobile-menu li a{
        font-size: 1rem !important;
    }
}

</style>

